# The system is a link to the kioku checkout, versioned in its own repo
.kioku
# The start page, generated on each machine (kioku home)
Home.md
# Obsidian: per-device state
.obsidian/workspace*.json
.obsidian/cache
.trash/
# Large media stays out of git (the original URL is in the raw/ frontmatter)
raw/assets/**/*.mp4
raw/assets/**/*.mov
raw/assets/**/*.mkv
# agents' sandbox placeholders and local settings (not real files)
.claude
.codex
.mcp.json
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.ripgreprc
.idea
.vscode
