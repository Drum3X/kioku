#!/usr/bin/env bash
# Prints "<version> <fingerprint>" for the Kioku copy this script belongs to. The fingerprint
# covers what install.sh sets up (the installer itself, the skill names, the skeleton files),
# so it changes exactly when an update needs the install step to run again.
set -euo pipefail
export LC_ALL=C
sys="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
sum() { if command -v sha256sum >/dev/null; then sha256sum; else shasum -a 256; fi; }
fp="$({ cat "$sys/install.sh"; (cd "$sys" && find skills skeleton -type f | sort); } | sum | cut -c1-12)"
printf '%s %s\n' "$(cat "$sys/VERSION" 2>/dev/null || echo unknown)" "$fp"
